# FastAPI backend, called directly from the browser (CORS) — no Next.js proxy, so SSE isn't buffered.
# Baked in at build time; override per visit with ?backend=<url>&mock=0
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# true until the backend is live → replays lib/mocks/report.example.json (override with ?mock=0 / ?mock=1)
NEXT_PUBLIC_USE_MOCK=true

